# Copy to .env and fill in. Never commit .env.
DB_URL=jdbc:postgresql://localhost:5432/resume
DB_USER=resume
DB_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
# Implementations chosen by environment variable (see docs/DESIGN.md section 2)
FILE_STORAGE=local
DATA_DIR=./data
# Cookie security: false for local HTTP development, set true wherever TLS terminates
SESSION_COOKIE_SECURE=false
