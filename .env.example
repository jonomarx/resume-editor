# Copy to .env and fill in. Never commit .env.
DB_URL=jdbc:postgresql://localhost:5432/resume
DB_USER=resume
DB_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
# Implementations chosen by environment variable (see docs/DESIGN.md section 2)
FILE_STORAGE=local
# LLM provider: none (default: every LLM feature fails with llm_unavailable and the UI disables it), or fake (tests,
# no network). Real providers arrive in Epic 6. An unknown value stops startup.
LLM_PROVIDER=none
# Matcher: tags (weighted tag overlap, the only one so far). An unknown value stops startup.
MATCHER=tags
DATA_DIR=./data
# Operational settings (defaults live in backend/app/src/main/resources/application.yml)
RENDERER_URL=http://localhost:8081
# Orphaned storage keys one version number may skip before a save fails
MAX_ORPHAN_KEY_ATTEMPTS=20
