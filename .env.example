# Copy to .env and fill in. Never commit .env.
DB_URL=jdbc:postgresql://localhost:5432/resume
DB_USER=resume
DB_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
# Implementations chosen by environment variable (see docs/DESIGN.md section 2)
FILE_STORAGE=local
DATA_DIR=./data
# Operational settings (defaults live in backend/app/src/main/resources/application.yml)
RENDERER_URL=http://localhost:8081
# Orphaned storage keys one version number may skip before a save fails
MAX_ORPHAN_KEY_ATTEMPTS=20
